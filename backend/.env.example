PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

JWT_SECRET=your_jwt_secret
SEARCHAPI_KEY=your_searchapi_key

# ============================================================
#  محل ذخیره‌ی فایل‌های آپلودی (backend/src/services/storageService.js)
# ============================================================
# local = پیش‌فرض؛ فایل‌ها در پوشه‌ی uploads کنار پروژه
#          (روی Render این دیسک موقت است و با هر دیپلوی پاک می‌شود)
# s3    = AWS S3 یا هر سرویس سازگار با S3
# r2    = Cloudflare R2
STORAGE_PROVIDER=local

# --- برای s3 / r2 (در حالت local لازم نیست) ---
S3_BUCKET=
S3_REGION=us-east-1
# برای R2: https://<account-id>.r2.cloudflarestorage.com  و S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# آدرس عمومی خواندن عکس‌ها (برای R2 الزامی):
#   R2: https://pub-<id>.r2.dev یا دامنه‌ی شخصی
#   S3: https://<bucket>.s3.<region>.amazonaws.com یا CDN
S3_PUBLIC_BASE_URL=
# پیشوند اختیاری داخل باکت (مثلاً uploads تا ساختار مسیر قبلی حفظ شود)
S3_KEY_PREFIX=
# پیش‌فرض: public-read فقط برای S3 خالص؛ برای R2 خالی بگذارید
S3_CANNED_ACL=
# برای سرویس‌های path-style مقدار true (به‌طور خودکار وقتی S3_ENDPOINT ست است فعال می‌شود)
S3_FORCE_PATH_STYLE=
# سقف زمان هر درخواست به استورج (میلی‌ثانیه)، پیش‌فرض ۳۰۰۰۰
S3_TIMEOUT_MS=30000
